# Runtime mode: development, test, or production.
NODE_ENV=development
# HTTP port the server listens on.
PORT=4000
# Compose Mongo. A gitignored server/.env can point this at Atlas instead.
MONGODB_URI=mongodb://mongo:27017/lumen
# HS256 signing secret. At least 32 characters. This placeholder is refused in production.
JWT_SECRET=dev-only-placeholder-not-a-secret-00
# OpenRouter API key.
OPENROUTER_API_KEY=replace-me
# Default model id sent to OpenRouter.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Browser origin of the client.
CLIENT_ORIGIN=http://localhost:5173
